# Valentine's Day App Configuration
# Copy this file to .env and customize as needed

# App Configuration
PAGE_TITLE=Will You Be My Valentine?

# Customization Options (optional)
PRIMARY_COLOR=#ff2e7a
SECONDARY_COLOR=#e63b3b
BACKGROUND_GRADIENT_START=#ff006e
BACKGROUND_GRADIENT_END=#fb5607

# Message Customization (optional)
QUESTION_TEXT=Will you be my Valentine?
YES_TEXT=Yes
NO_TEXT=No
SUCCESS_MESSAGE=YAYYYYY 💖
SUCCESS_NOTE=Best decision ever! 😍
FOOTER_NOTE="No" seems a bit shy 😈

# Streamlit Server Configuration (optional)
# PORT=8501
# SERVER_ADDRESS=localhost
